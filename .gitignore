# ---------------------------------------------------------------------------
# SECRETS — never commit. The only env file in git is .env.example (no values).
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
*.key
*.pem
secrets/
wallets/
.keystore/

# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
build/
out/
.next/
.turbo/
*.tsbuildinfo

# Hardhat — regenerated by `pnpm compile`, so never committed.
artifacts/
cache/
contracts/artifacts/
contracts/cache/
contracts/types/
coverage/
coverage.json

# Deployment records ARE committed (contracts/deployments/*.json): they hold the real
# addresses and tx hashes judges verify on MSTScan, and contain no secrets.

# Vercel
.vercel

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# OS / editor
.DS_Store
Thumbs.db
.idea/
*.swp

# Local scratch
scratch/
tmp/

# Playwright MCP scratch output (screenshots, snapshots, console logs)
.playwright-mcp/

# video/ — the demo film. Source is tracked; captures, audio and renders are not.
# It is deliberately NOT a pnpm workspace package (see pnpm-workspace.yaml), so
# CI never sees it: every CI step is --filter contracts or --filter web.
video/node_modules/
video/.venv/
video/out/
video/public/
video/assets/captured/
video/audio/vo/
video/audio/samples/
video/audio/*.wav
video/package-lock.json
