    "calibrate": "tsx scripts/calibrate.ts",
    "tick": "tsx scripts/tick.ts",
    "verify:approval": "tsx scripts/verify-approval.ts",
    "agents:register": "tsx scripts/register-agents.ts",
    "agents:over-cap": "tsx scripts/over-cap-bet.ts",
