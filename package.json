{
  "name": "auspex",
  "version": "0.1.0",
  "private": true,
  "description": "Prediction markets created under human authority, researched by AI agents the chain keeps on a leash. On MST Blockchain.",
  "license": "MIT",
  "author": "Arunish Rajput",
  "homepage": "https://auspex-web-mu.vercel.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arunishrajput/auspex.git"
  },
  "keywords": [
    "prediction-markets",
    "ai-agents",
    "solidity",
    "mst-blockchain",
    "human-in-the-loop"
  ],
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "dev": "pnpm --filter web dev",
    "compile": "pnpm --filter contracts compile",
    "deploy:testnet": "pnpm --filter contracts deploy:testnet",
    "verify:testnet": "pnpm --filter contracts verify:testnet",
    "wallets:new": "node scripts/new-wallet.mjs",
    "preflight": "node scripts/preflight.mjs",
    "check:links": "node scripts/check-links.mjs"
  },
  "devDependencies": {
    "ethers": "^6.17.0",
    "pg": "^8.23.0",
    "typescript": "^5.9.2"
  }
}
